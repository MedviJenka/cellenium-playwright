# cellenium configuration - run `cellenium doctor` after filling this in.

# Google Sheets locator spreadsheet (edit URL), shared with the service account in credentials.json
GOOGLE_SHEETS=
CREDENTIALS_JSON=credentials.json

# Vision agent model
OPENAI_MODEL=openai/gpt-5.5
OPENAI_API_KEY=

# Optional - logs stay local when empty
LOGFIRE_TOKEN=

TEST_HEADLESS=true
